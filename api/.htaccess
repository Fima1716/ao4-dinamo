# Все запросы /api/... обрабатывает index.php
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /api/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Заголовок Authorization нужен для входа в админку: без этой строки
# Apache не передаёт его в PHP, и панель будет отвечать «Нужна авторизация»
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# Настройки с паролем наружу не отдаём
<Files "config.php">
    Require all denied
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</Files>
